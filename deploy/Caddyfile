# TLS front for the live Hashu demo. Certificates come from Let's Encrypt
# automatically once $HASHU_DOMAIN resolves to this machine (sslip.io works) and
# ports 80/443 are open.
# HASHU_EXTRA_DOMAINS (default "hashu.io www.hashu.io") serve the same site;
# Caddy only gets their certificates once their A records point here, and
# mint.hashu.io keeps working either way.
{$HASHU_DOMAIN} {$HASHU_EXTRA_DOMAINS} {
	encode gzip

	# Hashu project splash page (site/, built into the caddy image) at / on
	# the extra domains (hashu.io, www). The mint's own host keeps the mint
	# landing page at /; every other path behaves the same on all hosts.
	@splash {
		path /
		not host {$HASHU_DOMAIN}
	}
	handle @splash {
		root * /srv/site
		file_server
	}

	# Slidev deck, built with --base /slides/ into the caddy image.
	redir /slides /slides/
	handle_path /slides/* {
		root * /srv/slides
		try_files {path} /index.html
		file_server
	}

	# Per-pool redemption guides (docs/redeem, rendered into the caddy
	# image), on every host so the checkout can link to them.
	redir /redeem /redeem/
	handle /redeem/* {
		root * /srv/site
		file_server
	}

	# MDK demo: the dashboard runs on its own host because the MDK shell
	# serves from / (its /auth, /apps and /app-ui paths are absolute).
	redir /mdk https://{$HASHU_MDK_DOMAIN}/ 302
	redir /mdk/ https://{$HASHU_MDK_DOMAIN}/ 302

	# Operator GUI (served by the control API). Password protected: its
	# POST api/controls pauses issuance and changes the markup.
	redir /operator /operator/
	handle_path /operator/* {
		basic_auth {
			{$OPERATOR_USER} {$OPERATOR_PASSWORD_HASH}
		}
		reverse_proxy hashu:3334
	}

	# Read-only redemption status for the MDK heater app
	# (hashuControlUrl = https://$HASHU_DOMAIN/control). GET only:
	# POST /redemptions and everything else on the control API stays private.
	handle_path /control/* {
		@status {
			method GET HEAD
			path /status
		}
		handle @status {
			reverse_proxy hashu:3334
		}
		respond 404
	}

	# Everything else, all on the mint port: the landing page (/), the
	# Cashu mint API (/v1/info, /v1/keys, quotes, ...) and the public buyer
	# checkout page (/checkout/).
	handle {
		reverse_proxy hashu:8085
	}
}

# MDK dashboard demo (Hashu Heater app on a mock heater). serve.js in the mdk
# container serves the built dashboard and forwards /auth, /apps, ... to the
# MDK Gateway.
{$HASHU_MDK_DOMAIN} {
	encode gzip
	reverse_proxy mdk:3030
}
