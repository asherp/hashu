# TLS front for a Hashu mint. Certificates come from Let's Encrypt
# automatically once $HASHU_DOMAIN resolves to this machine (sslip.io works) and
# ports 80/443 are open. HASHU_DOMAIN is required (the image's entrypoint
# refuses to start without it).
# HASHU_EXTRA_DOMAINS (optional, space separated, default none) serve the
# same site, with the project splash page at /; Caddy only gets their
# certificates once their A records point here, and $HASHU_DOMAIN keeps
# working either way.
{
	# Supplier mints (<name>.$HASHU_DOMAIN, see below) get their
	# certificates on first visit. The mint answers this check with 200
	# only for a registered supplier, so made-up names never reach
	# Let's Encrypt.
	on_demand_tls {
		ask http://hashu:8085/tls-ask
	}
}

{$HASHU_DOMAIN} {$HASHU_EXTRA_DOMAINS} {
	encode gzip

	# Hashu project splash page (site/, built into the caddy image) at / on
	# the extra domains. The mint's own host keeps the mint
	# landing page at /; every other path behaves the same on all hosts.
	@splash {
		path /
		not host {$HASHU_DOMAIN}
	}
	handle @splash {
		root * /srv/site
		file_server
	}

	# Slidev deck, built with --base /slides/ into the caddy image.
	redir /slides /slides/
	handle_path /slides/* {
		root * /srv/slides
		try_files {path} /index.html
		file_server
	}

	# Per-pool redemption guides (docs/redeem, rendered into the caddy
	# image), on every host so the checkout can link to them.
	redir /redeem /redeem/
	handle /redeem/* {
		root * /srv/site
		file_server
	}

	# MDK demo (optional, HASHU_MDK_DOMAIN): the dashboard runs on its own
	# host because the MDK shell serves from / (its /auth, /apps and /app-ui
	# paths are absolute). The entrypoint writes these redirects, or nothing.
	import /etc/caddy/generated/mdk-routes.caddy

	# Operator GUI (served by the control API). Password protected: its
	# POST api/controls pauses issuance and changes the markup.
	redir /operator /operator/
	handle_path /operator/* {
		basic_auth {
			{$OPERATOR_USER} {$OPERATOR_PASSWORD_HASH}
		}
		reverse_proxy hashu:3334
	}

	# Read-only redemption status for the MDK heater app
	# (hashuControlUrl = https://$HASHU_DOMAIN/control). GET only:
	# POST /redemptions and everything else on the control API stays private.
	handle_path /control/* {
		@status {
			method GET HEAD
			path /status
		}
		handle @status {
			reverse_proxy hashu:3334
		}
		respond 404
	}

	# Everything else, all on the mint port: the landing page (/), the
	# Cashu mint API (/v1/info, /v1/keys, quotes, ...) and the public buyer
	# checkout page (/checkout/).
	handle {
		reverse_proxy hashu:8085
	}
}

# Supplier mints: alice.$HASHU_DOMAIN is supplier alice's mint (registered
# in HASHU_SUPPLIERS_FILE), served by the same hashu process, which picks
# the mint by Host. Needs one wildcard DNS record, *.$HASHU_DOMAIN, pointing
# here. Certificates are per name, on demand (no DNS challenge needed).
*.{$HASHU_DOMAIN} {
	tls {
		on_demand
	}
	encode gzip
	reverse_proxy hashu:8085
}

# MDK dashboard demo (Hashu Heater app on a mock heater), only when
# HASHU_MDK_DOMAIN is set. serve.js in the mdk container serves the built
# dashboard and forwards /auth, /apps, ... to the MDK Gateway.
import /etc/caddy/generated/mdk-site.caddy
