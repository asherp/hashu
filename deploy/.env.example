# Copy to deploy/.env and fill in. Never commit .env.
#
# REQUIRED (no defaults; `docker compose up` stops and names the first one
# missing): HASHU_DOMAIN, HASHU_UPSTREAM, PHOENIXD_PASSWORD,
# PHOENIXD_LIMITED_PASSWORD, OPERATOR_PASSWORD_HASH.
# Everything else is optional. See deploy/README.md, "Configuration".

# REQUIRED. Public DNS name for this machine (an A record at your DNS
# provider). Caddy gets a Let's Encrypt certificate for it; wallets use
# https://$HASHU_DOMAIN and every token names it. Until a record resolves
# you can use <your-ip-with-dashes>.sslip.io, e.g. 203-0-113-7.sslip.io.
HASHU_DOMAIN=
# Optional: other names that serve the same site, with the project splash
# page at / (space separated, default none). Needs A records too.
HASHU_EXTRA_DOMAINS=

# Optional: how the mint presents itself (NUT-06), in wallets and on the
# landing page. Contact is comma separated method:info pairs.
# HASHU_MINT_NAME=Hashu
# HASHU_MINT_DESCRIPTION=
# HASHU_MINT_CONTACT=email:ops@example.com,nostr:npub1...,twitter:@you

# REQUIRED. phoenixd (mainnet). Generate both with: openssl rand -hex 32
#   PHOENIXD_PASSWORD          full access (can SEND). Stays inside phoenixd.
#   PHOENIXD_LIMITED_PASSWORD  invoices + payment lookups only. Given to hashu.
PHOENIXD_PASSWORD=
PHOENIXD_LIMITED_PASSWORD=
# Optional: restore an existing wallet on first boot (12/24 words). Leave empty
# to let phoenixd create a new wallet, then back up seed.dat (see README).
PHOENIXD_SEED=

# REQUIRED (the hash). Operator GUI login at https://$HASHU_DOMAIN/operator/
# Hash: docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
# Keep the SINGLE QUOTES: the bcrypt hash contains '$'.
OPERATOR_USER=operator
OPERATOR_PASSWORD_HASH='$2a$14$replace.with.output.of.caddy.hash-password'

# REQUIRED. Where miners go when no redemption is open: your pool. The
# miner's own username passes through on this route, so it must be an
# account (or, for a solo pool, a BTC address) on this pool. Rented rigs
# (MiningRigRentals) reject Testnet4 jobs, so use a mainnet pool for them.
# e.g. stratum+tcp://solo.ckpool.org:3333 or stratum+tcp://your-pool:3333
HASHU_UPSTREAM=
# Host port miners connect to (default 3335).
HASHU_STRATUM_PORT=3335

# Pricing: mrr (live MiningRigRentals SHA-256 rental floor: what the
# hashrate costs, same on any chain) | esplora (hashprice from recent blocks
# on HASHU_NETWORK: what it earns) | fixed.
HASHU_PRICE=mrr
HASHU_NETWORK=bitcoin
# Fixed price, and fallback while the live source has no fresh sample.
HASHU_SATS_PER_THH=40

# Lightning rail: phoenixd | fake (every invoice pays itself, rehearsal) | off
HASHU_LIGHTNING=phoenixd

# Stablecoin rails (optional), mainnet, REAL FUNDS. An address you
# control turns each coin on; the same EVM address may take both. Price
# them with a fixed dollar price per THH (HASHU_USDT_PER_THH, used for
# both coins), or from the sats price via USD/BTC.
HASHU_USDT_PER_THH=
HASHU_USD_PER_BTC=

# USDT, Ethereum mainnet by default. Leave the rest blank for defaults.
HASHU_USDT_DEPOSIT=
HASHU_USDT_TOKEN=
HASHU_USDT_RPC=
HASHU_USDT_CHAIN_ID=
HASHU_USDT_CONFIRMATIONS=

# USDC, Base mainnet by default (Circle native USDC, chain 8453).
HASHU_USDC_DEPOSIT=
HASHU_USDC_TOKEN=
HASHU_USDC_RPC=
HASHU_USDC_CHAIN_ID=
HASHU_USDC_CONFIRMATIONS=

# The public RPCs are fine to start; use your own node or a paid provider
# (Alchemy, Infura, ...) once real money flows: the mint trusts it.
# Other chains: set the coin's TOKEN, RPC and CHAIN_ID together, e.g. USDC
# on Ethereum = 0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48, chain 1.
# Rehearse on Sepolia: chain 11155111, RPC
# https://ethereum-sepolia-rpc.publicnode.com, test USDT
# 0x7169D38820dfd117C3FA1f22a697dBA58d90BA06, Circle test USDC
# 0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238.

# Capacity: how many THH the mint can sell = rented TH/s x hours left,
# minus THH already owed. With an MRR API key (read access is enough) the
# mint syncs the account's active rentals every minute; otherwise set
# rentals in the operator GUI. Optional: only count these rental ids
# (comma separated), e.g. when other rentals mine elsewhere.
MRR_API_KEY=
MRR_API_SECRET=
HASHU_MRR_RENTAL_IDS=

# Heat estimate on the operator page: heat = work x J/TH. J/TH comes from
# each rental's rig name when it names a model (S21, S19j Pro, M30S, ...);
# rigs it cannot match use this default (S19-class). Changeable in the GUI.
HASHU_HEAT_J_PER_TH=30

RUST_LOG=info

# Optional MDK dashboard demo (Hashu Heater app on a mock heater). Off by
# default; turn it on with COMPOSE_PROFILES=mdk and all three below.
# https://$HASHU_DOMAIN/mdk redirects to HASHU_MDK_DOMAIN, which must resolve
# to this machine (mdk.<ip-with-dashes>.sslip.io works with no DNS change).
# The stack is all mock (its own fake-Lightning demo mint and fake pools), so
# this user can't touch the live mint. MDK wants a 12+ character password.
# COMPOSE_PROFILES=mdk
HASHU_MDK_DOMAIN=
MDK_DEMO_USER=
MDK_DEMO_PASSWORD=

# Images. CI publishes them to GHCR on every push to main
# (.github/workflows/images.yml): `docker compose pull && docker compose up -d`
# deploys without compiling. Pin a build with HASHU_IMAGE_TAG=sha-<short>.
# `docker compose up -d --build` still builds locally under the same names.
# Images come from the upstream project's registry by default; point this at
# your fork's registry (ghcr.io/<owner>) to deploy your own builds.
# HASHU_REGISTRY=ghcr.io/asherp
# HASHU_IMAGE_TAG=latest
